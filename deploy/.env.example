# ============================================================
# chatroom 部署环境变量模板
# ============================================================
# 用法:
#   1. cp deploy/.env.example deploy/.env
#   2. 把 CHANGE_ME / 占位值改成真实值
#   3. docker compose -f deploy/docker-compose.yml up -d
#
# deploy/.env 已在 .gitignore 中,不会被误提交。
#
# ---- 跟共享底座的关系 ----
# MYSQL_ROOT_PASSWORD / REDIS_PASSWORD 是**连共享底座**用的凭证，
# 值必须跟 deploy/infra/.env 里填的一致。
#
# 底座先起：
#   cd deploy/infra && ./deploy.sh up

# -------- 共享底座凭证 --------
# 跟 deploy/infra/.env 填同一个值
MYSQL_ROOT_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# -------- nacos --------
# 服务注册到 nacos 的地址（容器名或 IP）。
# nacos 也在本 compose 里，同在 shared-infra-net 网络，用容器名。
NACOS_SERVERS=chatroom-nacos:8848
# 命名空间。留空用 public（""），开发环境用的是 uuid 命名空间。
NACOS_NAMESPACE=CHANGE_ME_namespace_id
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=nacos
NACOS_PASSWORD=CHANGE_ME
# nacos 3.x 的 JWT 签名密钥（nacos.core.auth.plugin.nacos.token.secret.key）。
# **必须换成自己的随机值** —— 留空或用默认值等于没设防，
# 任何人拿默认密钥就能伪造 nacos token。
# 生成：openssl rand -hex 32
# 改动会让已发的 token 失效 —— 改完要重启 nacos 和五个服务。
NACOS_AUTH_TOKEN=CHANGE_ME_nacos_auth_token_min_32_chars

# -------- 鉴权 --------
# JWT 签名密钥。五个服务必须一致。至少 32 字符。
# 生成：openssl rand -hex 32
AUTH_JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars
# 服务间内部调用凭证（走 X-Internal-Token 头）。五个服务必须一致 ——
# 不一致的话内部端点一律 403。
# 生成：openssl rand -hex 32
AUTH_INTERNAL_SECRET=CHANGE_ME_internal_secret_min_32_chars

# -------- 容器镜像 --------
# 镜像名前缀和标签。CI 里把 ACR 镜像 re-tag 成
# ${IMAGE_PREFIX}/${服务名}:${IMAGE_TAG}。
IMAGE_PREFIX=chatroom
IMAGE_TAG=server-latest

# -------- 容器镜像仓库（跟 ACR 控制台一致）--------
# 公网端点（不带 -vpc）
ACR_REGISTRY_HOST=crpi-<id>.<region>.personal.cr.aliyuncs.com
ACR_NAMESPACE=<your-ns>/<your-repo-prefix>

# nacos 镜像的 tag。ACR 里按 ACR_REGISTRY_HOST/ACR_NAMESPACE 拉时用
# nacos-3.2.4；改用 Docker Hub 官方镜像时（ACR_REGISTRY_HOST=nacos,
# ACR_NAMESPACE=nacos-server）用 v3.2.4。
NACOS_IMAGE_TAG=nacos-3.2.4

# -------- nacos 的宿主端口 --------
# 默认 8848 / 9848 / 9849。宿主上已经有 nacos 跑着时改这里避开冲突。
# 容器内端口固定不变，业务服务按容器名 chatroom-nacos:8848 连，不受影响。
NACOS_HOST_PORT=8848
NACOS_GRPC_HOST_PORT=9848
NACOS_GRPC2_HOST_PORT=9849

# -------- ECS 上 pull 镜像用的登录凭证 --------
# 注意: GitHub Actions build job push 用的凭据配在 GitHub Secrets,
#       这一对是 ECS 拉取用的,需要在 ACR 控制台单独开 RAM 账号
REGISTRY_USERNAME=CHANGE_ME_acr_ram_user
REGISTRY_PASSWORD=CHANGE_ME_acr_ram_password
